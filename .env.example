# ---- Database ----
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet_hub

# ---- HTTP ----
API_BIND=0.0.0.0:8080
# Public URL that BigBang and Stripe can reach (ngrok / cloudflared tunnel in dev).
PUBLIC_BASE_URL=https://your-tunnel.example.com
# Where the Vue app runs (CORS). Comma separated.
WEB_ORIGINS=http://localhost:5173

# ---- Operator access (choose a long random string) ----
OPS_API_KEY=change-me-ops-key
# Signs the session cookie (choose a long random string). Random per boot when unset.
SESSION_SECRET=change-me-session-secret
# Set true when the api is served over HTTPS.
COOKIE_SECURE=false

# ---- BigBang Casino API ----
# Your ek_test_ sandbox key from https://api.bigbangcasino.bet/portal
BIGBANG_API_KEY=ek_test_xxxxxxxxxxxxxxxxx
BIGBANG_BASE_URL=https://api.bigbangcasino.bet
# sandbox | live  (which key you configured above)
BIGBANG_ENV=sandbox

# ---- Stripe (test mode) ----
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
# From `stripe listen --forward-to localhost:8080/webhooks/stripe` or the Dashboard webhook.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx

# ---- Sportsbook (our own mock service) ----
SPORTS_BASE_URL=http://localhost:8090
# Shared secret between api and mock-sportsbook (choose a long random string)
SPORTS_CALLBACK_SECRET=change-me-sports-secret

# ---- mock-sportsbook service ----
SPORTS_BIND=0.0.0.0:8090
WALLET_CALLBACK_URL=http://localhost:8080/callbacks/sports
# Optional: real odds from https://the-odds-api.com (free tier). Leave empty for built-in fixtures.
ODDS_API_KEY=
# Seconds after a bet is placed before the mock settles it.
SETTLE_AFTER_SECS=30

# ---- Logging ----
RUST_LOG=info,api=debug,ledger=debug,provider_bigbang=debug
